{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-manifest.schema.json",
  "title": "Retained case manifest",
  "$comment": "HARNESS.md Section 12. Every retained case is validated against this schema before execution. Inconsistent shapes (errorAssertion 'exact' without an error, 'unspecified' with an error, an accepted result carrying error fields, or both/neither of inline input and inputPath) fail validation and are harness errors. Milestone 0 commits the schema; no protocol case exists yet, so the operation enum lists the runner v1 protocol operations that later milestones will deliver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "runnerProtocol",
    "operation",
    "specificationCommit",
    "specificationSections",
    "derivationStatus",
    "faultProfile",
    "expected"
  ],
  "oneOf": [
    { "required": ["input"] },
    { "required": ["inputPath", "inputSha256"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "runnerProtocol": { "const": "1" },
    "operation": {
      "enum": [
        "deriveIdentity",
        "authorRecord",
        "verifyRecord",
        "selectCurrent",
        "strictEd25519",
        "nextTimestamp",
        "validateCbor"
      ]
    },
    "input": {
      "$comment": "Complete inline operation input, in the runner JSON profile.",
      "type": "object"
    },
    "inputPath": {
      "type": "string",
      "pattern": "^cases/[A-Za-z0-9._/-]+$"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "specificationCommit": {
      "const": "abc9a55d90f1026e6509207abda73e5dc6d14241"
    },
    "specificationSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derivationStatus": {
      "enum": ["specification", "implementation", "confirmed"]
    },
    "faultProfile": {
      "enum": ["none", "single", "multiple", "unknown"]
    },
    "expected": {
      "oneOf": [
        {
          "title": "accepted",
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": { "const": "accepted" }
          }
        },
        {
          "title": "rejected with exact error assertion",
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "errorAssertion", "error"],
          "properties": {
            "outcome": { "const": "rejected" },
            "errorAssertion": { "const": "exact" },
            "error": {
              "enum": [
                "invalidDid",
                "unsupportedHash",
                "unsupportedSuite",
                "recordTooLarge",
                "invalidCbor",
                "nonDeterministicCbor",
                "schemaViolation",
                "identityBindingMismatch",
                "invalidRevocationKey",
                "invalidSignature",
                "premature",
                "rootRevoked",
                "losingRecord",
                "duplicate",
                "policyRejected",
                "rateLimited",
                "responseTooLarge",
                "temporarilyUnavailable",
                "invalidCursor",
                "internalError"
              ]
            }
          }
        },
        {
          "title": "rejected with unspecified error assertion",
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "errorAssertion"],
          "properties": {
            "outcome": { "const": "rejected" },
            "errorAssertion": { "const": "unspecified" }
          }
        }
      ]
    },
    "derivedFrom": {
      "$comment": "Present only for derived negative cases. resignedKey (the published test key used for re-signing) is required exactly when resigned is true and forbidden when resigned is false.",
      "oneOf": [
        {
          "title": "re-signed derivation",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseVector",
            "mutation",
            "protectedBytesChanged",
            "payloadBytesChanged",
            "resigned",
            "resignedKey"
          ],
          "properties": {
            "baseVector": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "mutation": {
              "type": "string",
              "minLength": 1
            },
            "protectedBytesChanged": { "type": "boolean" },
            "payloadBytesChanged": { "type": "boolean" },
            "resigned": { "const": true },
            "resignedKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "title": "derivation without re-signing",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseVector",
            "mutation",
            "protectedBytesChanged",
            "payloadBytesChanged",
            "resigned"
          ],
          "properties": {
            "baseVector": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "mutation": {
              "type": "string",
              "minLength": 1
            },
            "protectedBytesChanged": { "type": "boolean" },
            "payloadBytesChanged": { "type": "boolean" },
            "resigned": { "const": false }
          }
        }
      ]
    },
    "producedBy": {
      "enum": ["followee-rs", "followee-python-cleanroom"]
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["implementation", "commit"],
        "properties": {
          "implementation": {
            "enum": ["followee-rs", "followee-python-cleanroom"]
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tag": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
