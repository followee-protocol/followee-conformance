{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hello-result.schema.json",
  "title": "hello operation accepted result",
  "$comment": "HARNESS.md Section 8. Commit values are supplied by the build or verified checkout, never by an unchecked runtime environment variable; the orchestrator additionally compares every commit against the Section 2 pins. The optional namespaced 'diagnostic' member is excluded from equality (Section 13).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "adapterVersion",
    "implementationRepository",
    "implementationCommit",
    "specificationCommit",
    "runnerProtocols",
    "operations"
  ],
  "properties": {
    "adapter": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "implementationRepository": {
      "type": "string",
      "pattern": "^https://[^ ]+$"
    },
    "implementationCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "specificationCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runnerProtocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hello",
          "deriveIdentity",
          "authorRecord",
          "verifyRecord",
          "selectCurrent",
          "strictEd25519",
          "nextTimestamp",
          "validateCbor"
        ]
      }
    },
    "diagnostic": {
      "type": "object"
    }
  }
}
